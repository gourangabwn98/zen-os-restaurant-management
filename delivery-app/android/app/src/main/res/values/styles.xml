<resources>
    <!-- Normal app theme (set in MainActivity.onCreate before React draws). -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/zen_bg</item>
        <item name="android:statusBarColor">@color/zen_brand</item>
    </style>
    <!-- Launch: brand background + mark, shown until the JS splash takes over. -->
    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>

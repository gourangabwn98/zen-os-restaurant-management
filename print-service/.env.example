# ── Central backend connection ────────────────────────────────────────────
# The server address only — no /api at the end (it is removed if present).
BACKEND_URL=https://your-backend.example.com

# ── Printer device credential ─────────────────────────────────────────────
# Created once by an admin via POST /api/admin/printer/devices in the Admin
# app (or curl). The plaintext key is only ever shown at creation time —
# copy it here immediately. This key, not a staff login, is how this
# service authenticates. Keep this file out of version control.
PRINTER_KEY=prn_replace_with_real_key

# ── Local queue persistence ───────────────────────────────────────────────
QUEUE_FILE=./data/queue.json

# ── Retry behaviour ────────────────────────────────────────────────────────
MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=3000
RETRY_SWEEP_INTERVAL_MS=15000

# ── Printer health check ──────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL_MS=20000

# Set to "true" to use the in-memory mock printer driver instead of real
# hardware — useful for a dry run before wiring up an actual printer.
USE_MOCK_PRINTER=false

# How often to check the backend for jobs whose live push didn't reach this
# service (e.g. created by another backend instance sharing the database).
QUEUE_POLL_INTERVAL_MS=20000

# ── Bill logo (the logo set in Admin → Profile) ───────────────────────────
# PRINT_LOGO=false to leave it off. Size is in printer dots: a 58 mm roll is
# ~384 dots wide, 80 mm ~576. LOGO_INVERT: auto (invert logos on a dark
# background so the artwork prints black on white), true or false.
PRINT_LOGO=true
LOGO_WIDTH=192
LOGO_HEIGHT=160
LOGO_INVERT=auto

# Last line printed on the bill, under "Thank you! Visit again :)".
# Leave empty (BILL_FOOTER=) to print nothing there.
BILL_FOOTER=Powered by Zen OS

# "Scan & Pay" QR at the bottom of unpaid bills: a UPI QR with the bill
# amount filled in (from the UPI ID in Admin → Profile → Payment), or the
# uploaded payment QR image if no UPI ID is set. Size in printer dots.
PRINT_PAY_QR=true
PAY_QR_SIZE=240

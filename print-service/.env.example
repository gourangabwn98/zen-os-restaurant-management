# ── Central backend connection ────────────────────────────────────────────
BACKEND_URL=https://your-backend.example.com

# ── Printer device credential ─────────────────────────────────────────────
# Created once by an admin via POST /api/admin/printer/devices in the Admin
# app (or curl). The plaintext key is only ever shown at creation time —
# copy it here immediately. This key, not a staff login, is how this
# service authenticates. Keep this file out of version control.
PRINTER_KEY=prn_replace_with_real_key

# ── Local queue persistence ───────────────────────────────────────────────
QUEUE_FILE=./data/queue.json

# ── Retry behaviour ────────────────────────────────────────────────────────
MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=3000
RETRY_SWEEP_INTERVAL_MS=15000

# ── Printer health check ──────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL_MS=20000

# Set to "true" to use the in-memory mock printer driver instead of real
# hardware — useful for a dry run before wiring up an actual printer.
USE_MOCK_PRINTER=false

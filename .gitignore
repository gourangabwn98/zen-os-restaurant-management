# ─────────────────────────────────────────────────────────────────────────
# Root .gitignore — Restaurant Management System monorepo
# Applies to admin/, customer/, waiter/, kitchen/, restaurant-server/,
# print-service/ and any future app added under this root.
# Per-app .gitignore files may add app-specific rules on top of this.
# ─────────────────────────────────────────────────────────────────────────

# Dependencies
node_modules/

# Environment variables — never commit real secrets, only *.example templates
.env
.env.*
!.env.example

# Build output
dist/
dist-ssr/
build/

# Test/coverage output
coverage/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local

# print-service runtime state (disk-persisted print queue — local, not shared)
print-service/data/queue.json

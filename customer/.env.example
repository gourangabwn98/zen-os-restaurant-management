VITE_API_URL=https://your-backend.example.com/api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# ── Offer push notifications (Cloud Messaging) ────────────────────────────
# Both come from Firebase Console → Project Settings → Cloud Messaging.
# VITE_FIREBASE_MESSAGING_SENDER_ID: "Project settings" → "Cloud Messaging" tab (Sender ID).
# VITE_FIREBASE_VAPID_KEY: same tab → "Web configuration" → "Generate key pair".
# Also update the hardcoded copy of these values in public/firebase-messaging-sw.js.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=

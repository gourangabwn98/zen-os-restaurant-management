# Zen OS — Offline Edition (restaurant PC) environment template.
# Copy to .env ON THE RESTAURANT PC ONLY. Never copy this onto the cloud server.
# Setup and recovery: docs/offline-edition/11-local-setup-and-recovery.md
#
# Everything not listed here works as in .env.example. Twilio/MSG91, PhonePe,
# Cloudinary and WhatsApp may be left blank; they need internet anyway.
# FIREBASE_* MUST be filled in (same values as .env.example): the server reads
# the service account at startup and will not start without it. Reading it
# needs no internet; phone login and push do.

# ── Deployment mode ─────────────────────────────────────────────────────────
# LOCAL = this PC is the only writer for this restaurant (config/deploymentMode.js).
# Leave unset on the cloud server.
DEPLOYMENT_MODE=LOCAL

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
TZ=Asia/Kolkata

# ── Database: MongoDB on THIS PC, as a replica set ─────────────────────────
# Must be mongodb:// on 127.0.0.1 with replicaSet=… — the server refuses
# to start otherwise (an Atlas/+srv or remote address is rejected).
# One-time: node scripts/localReplicaSet.js
MONGO_URI=mongodb://127.0.0.1:27017/zen_local?replicaSet=rs0

# ── Auth ────────────────────────────────────────────────────────────────────
# A NEW random value for this restaurant (never the cloud's, never the sandbox's):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# ── Staff PIN login (phase O2) — all required ──────────────────────────────
# Staff (admin, manager, inventory, waiter, chef) sign in with phone + PIN on
# a device the admin approved. SMS-OTP / Firebase staff login is switched off
# in this mode. Customers are unaffected.
#
# Pepper mixed into every PIN hash. Stored ONLY here, never in the database,
# so a copied database or backup can't be used to guess PINs. Must differ
# from JWT_SECRET. KEEP A COPY with the restaurant's backups: if it is lost,
# every staff PIN must be reset (doc 11 → "Lost PIN pepper").
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCAL_PIN_PEPPER=replace_with_64_random_hex_characters
# This restaurant's ID (3–40 lowercase letters, digits, dashes). First-time
# setup asks for it, so setup can't be completed against the wrong install.
LOCAL_SITE_ID=adds-cafe
# How long a PIN sign-in lasts before staff must enter the PIN again (1–24).
LOCAL_SESSION_HOURS=12

# ── Firebase (required — see top of file) ──────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"

# ── Web apps served by this PC (local/staticApps.js) ───────────────────────
# Each app on its own port. Open from any phone on the Wi-Fi:
#   http://<this-PC-IP>:8080 customer · :8081 admin · :8082 waiter · :8083 kitchen
LOCAL_PORT_CUSTOMER=8080
LOCAL_PORT_ADMIN=8081
LOCAL_PORT_WAITER=8082
LOCAL_PORT_KITCHEN=8083
# Folder holding admin/ customer/ waiter/ kitchen/ (each a built dist folder).
# Unset = <repo>/<app>/dist from a developer checkout.
# LOCAL_APPS_DIR=C:\ZenOS\apps

# ── Table QR codes ──────────────────────────────────────────────────────────
# The customer app's address on the restaurant Wi-Fi. Give this PC a FIXED IP
# (router DHCP reservation) first — printed QR codes contain this address.
CUSTOMER_FRONTEND_URL=http://192.168.1.20:8080
CLIENT_URL=http://192.168.1.20:8080

# ── Never set these in the Offline Edition ─────────────────────────────────
# OTP_DEV_ECHO=true          → refused at startup (hands out login codes on the Wi-Fi)
# DISABLE_BACKGROUND_JOBS    → warned: this PC is the only place jobs run

# ── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-customer-app.example.com
# TBL-01: the customer PWA address table QR codes open (absolute https URL).
CUSTOMER_FRONTEND_URL=https://your-customer-app.example.com
# GLB-01/02: fallback restaurant name for server-side text (SMS) when the
# profile has none. The Admin → Profile name always wins.
BRAND_NAME=Hotel KHOAI

# ── Database (single-restaurant mode) ─────────────────────────────────────
# The ENTIRE system (customer, waiter, admin) always uses this one database.
# See middleware/authMiddleware.js.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<your_restaurant_db>

# ── Auth ───────────────────────────────────────────────────────────────────
# A RANDOM value, 64+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it logs everyone out once (all old login tokens stop working) —
# that is how you rotate it. The server warns at startup if it looks weak.
JWT_SECRET=replace_with_a_long_random_string

# ── Firebase (customer + admin phone-OTP login via Firebase Auth) ─────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Cloudinary (menu item / banner images) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Twilio (waiter OTP via SMS, WhatsApp bill/support notifications) ──────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── MSG91 (alternate/production SMS OTP provider — optional) ──────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ── PhonePe Payment Gateway (customer online payments) ───────────────────
# The salt key is a SECRET — same category as JWT_SECRET. Leave
# PHONEPE_MERCHANT_ID / PHONEPE_SALT_KEY blank to disable gateway payments;
# the customer app then falls back to the UPI deep link / cash.
# A verified PhonePe result (server-to-server callback OR our own signed
# status query) is the ONLY thing that auto-marks an order PAID — see
# services/paymentService.js and CLAUDE.md "Payment".
PHONEPE_ENV=SANDBOX
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
# Public base URL of THIS backend, used to build the PhonePe callback URL
# (e.g. https://api.yourrestaurant.com). Falls back to the incoming request's
# host when blank — set it explicitly if you sit behind a proxy that rewrites Host.
PUBLIC_API_URL=

# ── Inventory → Import Purchase (PDF/image line-item extraction) ──────────
# No API key needed — text-PDF extraction (pdf-parse) and OCR (tesseract.js)
# both run locally in this process, no external service required.
# tesseract.js DOES need outbound internet access the first time it runs on
# a given machine, to download its English trained-data file (~4MB, then
# cached on disk); if this server has no outbound internet, OCR for scanned
# PDFs/images will fail with a clear error until that first download succeeds.

# ── Time zone ──────────────────────────────────────────────────────────────
# Attendance / payroll days use the server clock. Most hosts run in UTC, which
# moves shifts before 5:30 AM IST to the previous day. Set the restaurant's zone:
TZ=Asia/Kolkata

# ── Local testing only ─────────────────────────────────────────────────────
# OTP_DEV_ECHO=true returns staff/admin OTPs in the API response when no SMS
# provider is set. NEVER in production (ignored when NODE_ENV=production).
# OTP_DEV_ECHO=
# If Node cannot resolve the mongodb+srv:// address (ECONNREFUSED on SRV
# lookup) while the OS can, point Node at other DNS servers:
# MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8

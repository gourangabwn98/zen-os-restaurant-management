# ── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-customer-app.example.com

# ── Database (single-restaurant mode) ─────────────────────────────────────
# The ENTIRE system (customer, waiter, admin) always uses this one database.
# See middleware/authMiddleware.js.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<your_restaurant_db>

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string

# ── Firebase (customer + admin phone-OTP login via Firebase Auth) ─────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Cloudinary (menu item / banner images) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Twilio (waiter OTP via SMS, WhatsApp bill/support notifications) ──────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── MSG91 (alternate/production SMS OTP provider — optional) ──────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ── Inventory → Import Purchase (PDF/image line-item extraction) ──────────
# No API key needed — text-PDF extraction (pdf-parse) and OCR (tesseract.js)
# both run locally in this process, no external service required.
# tesseract.js DOES need outbound internet access the first time it runs on
# a given machine, to download its English trained-data file (~4MB, then
# cached on disk); if this server has no outbound internet, OCR for scanned
# PDFs/images will fail with a clear error until that first download succeeds.
